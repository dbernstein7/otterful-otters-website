{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/([^/]+\\.(?:glb|fbx|png|jpe?g|webp|gif|bin))$",
      "dest": "/games/shell-snag/$1"
    },
    {
      "src": "/((?!api).*)",
      "dest": "/index.html"
    }
  ]
}

