{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/mml/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    },
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/branding/(.*)$",
      "dest": "/games/shell-snag/branding/$1"
    },
    {
      "src": "/mixamo/(.*)$",
      "dest": "/games/shell-snag/mixamo/$1"
    },
    {
      "src": "/models/(.*)$",
      "dest": "/games/shell-snag/models/$1"
    },
    {
      "src": "/([^/]+\\.(?:glb|fbx|bin|mp3|wav|ogg|m4a))$",
      "dest": "/games/shell-snag/$1"
    },
    {
      "src": "/((?!api)(?!mml/)(?!AvatarBuilder/)(?!metadata/)(?!games/).*)",
      "dest": "/index.html"
    }
  ]
}

