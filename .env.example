# Otter Kart Drip rewards (server-only — never expose in client code or git)
OTTER_KART_DRIP_API_KEY=

# OTTER ARMY realm (defaults match lib/otter-kart-rewards/env.js if omitted)
# OTTER_KART_DRIP_REALM_ID=67dfb2d4e88a620c1498e2ba
# OTTER_KART_DRIP_CURRENCY_ID=67dfb2d4d7a2230e68bad767
# OTTER_KART_DRIP_PATCH_MODE=delta

# Optional limits
# OTTER_KART_REWARDS_MAX_SHELLS_PER_CLAIM=50000
# OTTER_KART_DRIP_MAX_AWARD_PER_RUN=500

# Central Clam ledger (Phase 1 — KV-backed, source of truth for profile Clams)
# OTTERFUL_CLAMS_RECORD_SECRET=
# OTTERFUL_CLAMS_SYNC_SECRET=
# OTTERFUL_CLAMS_MAX_AWARD_PER_RECORD=50000
# OTTERFUL_CLAMS_ALLOWED_GAMES=otter-kart,shell-rush,shell-snag
# OTTERFUL_CLAMS_HISTORY_DEFAULT_LIMIT=25
# OTTERFUL_CLAMS_HISTORY_MAX_LIMIT=50

# External rewards provider (Phase 6 — migration: drip | urnz | both | none)
# Default drip preserves existing Drip behavior. Profile always reads central Clam ledger.
# OTTERFUL_REWARDS_PROVIDER=drip

# URNZ synchronization (server-only — never expose in client code or git)
# Required scopes: read:realm, read:members, write:balances
# URNZ_API_KEY=
# URNZ_REALM_ID=9ee65660fbd2344f82ad71ad
# URNZ_BASE_URL=https://www.urnz.app/api/v1
# URNZ_MEMBER_SEARCH_TYPE=wallet-evm
# URNZ_CURRENCY_ID=

# Local dev only — never enable on production
# OTTER_KART_REWARDS_ALLOW_UNSIGNED_DEV=1

# Shell Snag / Shell Rush rewards (Phase 3 — verified gate + upstream Drip)
# SHELL_RUSH_REWARDS_MAX_SHELLS_PER_CLAIM=50000
# SHELL_RUSH_DRIP_MAX_AWARD_PER_RUN=
# SHELL_RUSH_UPSTREAM_AWARD_URL=https://shell-rush-otterful-otters.vercel.app/api/rewards/award
# SHELL_RUSH_UPSTREAM_CHECK_URL=https://shell-rush-otterful-otters.vercel.app/api/rewards/check
# SHELL_RUSH_REWARDS_ALLOW_UNSIGNED_DEV=1
