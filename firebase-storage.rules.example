// Example Firebase Storage rules for public READ of wearables (site + MML).
// Firebase Console → Storage → Rules. Without read access, URLs return 403 unless you use &token=.
//
// Tighten `write` for production (e.g. only authenticated admin).

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /Furs/{file} {
      allow read: if true;
      allow write: if false;
    }
    match /Hats/{file} {
      allow read: if true;
      allow write: if false;
    }
    match /Shirts/{file} {
      allow read: if true;
      allow write: if false;
    }
    match /Eyes/{file} {
      allow read: if true;
      allow write: if false;
    }
  }
}
