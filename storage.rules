// Deploy to fix browser 403 on GLB URLs: from repo root run:
//   npm i -g firebase-tools   (once)
//   firebase login            (once)
//   firebase deploy --only storage
//
// Rules: anyone may READ files under Furs/, Hats/, Shirts/, Eyes/ (needed for MML / viewer.mml.io).
// Tighten `write` in production (e.g. authenticated admin only).

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /Furs/{file} {
      allow read: if true;
      allow write: if false;
    }
    match /Hats/{file} {
      allow read: if true;
      allow write: if false;
    }
    match /Shirts/{file} {
      allow read: if true;
      allow write: if false;
    }
    match /Eyes/{file} {
      allow read: if true;
      allow write: if false;
    }
  }
}
